# Copy this file to .env and fill in your API keys

# Clínica Arenal (HackSpain "El Turno" API)
CLINIC_API_BASE_URL=https://hackspain.getprosperapp.com/api
CLINIC_API_KEY=

# LLM provider: helmcode (default) | gemini | openai
LLM_PROVIDER=helmcode
HELMCODE_API_KEY=
HELMCODE_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# STT: soniox (default) | deepgram
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5

# TTS: elevenlabs (default) | deepgram
# eleven_v3 / eleven_v3_conversational → Text-to-Dialogue (not eleven_flash_v3; that id does not exist)
# anything else (eleven_flash_v2_5, turbo, multilingual_v2) → TTS WebSocket
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=es

# Deepgram (STT/TTS fallback when STT_PROVIDER or TTS_PROVIDER is deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# Daily (WebRTC transport; optional)
DAILY_API_KEY=

# Twilio (only needed for auto hang-up via the Twilio REST API; the harness does not need it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Tests only: pin the call's connect time (Europe/Madrid, ISO with offset)
# CALL_CLOCK_OVERRIDE=2026-09-18T10:00:00+02:00
