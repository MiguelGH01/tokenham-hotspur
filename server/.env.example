# Copy this file to .env and fill in your API keys

# Voice agent for Prosper Twilio /ws calls AND console Place-test-call:
#   carloslabs  — Pipecat cascade (default; STT → LLM → TTS)
#   elevenagent — ElevenLabs ConvAI bridge (Node sidecar; same console via obs ingest)
# Eval transport always uses carloslabs regardless of this setting.
VOICE_AGENT=carloslabs
# Required when VOICE_AGENT=elevenagent (ElevenLabs Agents agent id)
ELEVEN_AGENT_ID=
# Optional local port for the Node sidecar (default 3000)
# ELEVENAGENT_PORT=3000

# Clínica Arenal (HackSpain "El Turno" API)
CLINIC_API_BASE_URL=https://hackspain.getprosperapp.com/api
CLINIC_API_KEY=

# LLM provider: cloudflare (default, Claude Sonnet 4.6) | helmcode | gemini | openai
LLM_PROVIDER=cloudflare
# Cloudflare unified AI API (Anthropic Messages). Token: Account > Workers AI > Read.
# Third-party Claude is billed via AI Gateway Unified Billing credits, not Workers Paid neurons.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_LLM_MODEL=anthropic/claude-sonnet-4.6
# Optional: pin an AI Gateway; omit to use the account default.
# CLOUDFLARE_AI_GATEWAY_ID=default
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5
TTS_PROVIDER=deepgram
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# No eleven_flash_v3 id exists. Flash realtime = eleven_flash_v2_5.
# For Eleven v3 conversational set eleven_v3_conversational (Dialogue TTS).
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional: force a language code (e.g. es, en) instead of auto-detecting.
ELEVENLABS_LANGUAGE=

# Optional fallbacks
# LLM_PROVIDER=helmcode|gemini|openai
HELMCODE_API_KEY=
HELMCODE_MODEL=deepseek-v4-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Optional: Jev (TypeSafe AI). Shared key for emergency_watch (in-call red flags)
# and post-call conversation insights (console Insights page). Unset = both off /
# insights emit typesafe_unconfigured. See emergency_watch.py and observability/insights.py.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# STT: soniox (default) | deepgram
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5

# TTS: elevenlabs (default) | deepgram
# eleven_v3 / eleven_v3_conversational → Text-to-Dialogue (not eleven_flash_v3; that id does not exist)
# anything else (eleven_flash_v2_5, turbo, multilingual_v2) → TTS WebSocket
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_LANGUAGE=es

# Deepgram (STT/TTS fallback when STT_PROVIDER or TTS_PROVIDER is deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# Daily (WebRTC transport; optional)
DAILY_API_KEY=

# Twilio (only needed for auto hang-up via the Twilio REST API; the harness does not need it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Inbound audio uses Pipecat RNNoiseFilter (PR-12). No extra env.

# Tests only: pin the call's connect time (Europe/Madrid, ISO with offset)
# CALL_CLOCK_OVERRIDE=2026-09-18T10:00:00+02:00

# Loguru sink level for bot.py. Defaults to INFO on real calls because DEBUG
# prints live STT transcriptions and TTS text — patient name/DNI/phone/health
# reason in plaintext. `make eval` / `evals-parallel` set LOG_LEVEL=DEBUG
# themselves (synthetic personas) so scenario failures stay debuggable.
# LOG_LEVEL=DEBUG
# Process logs (always on). Defaults to server/run-logs/bot.log plus
# server/run-logs/bot-<timestamp>.log. Gitignored.
# LOG_DIR=run-logs

# Opt-in call recording: one stereo .wav per call (user left, bot right) under
# RECORDINGS_DIR when the call ends. Off by default — recording a real patient
# is a compliance decision, not just debugging.
# RECORD_CALLS=1
# RECORDINGS_DIR=run-logs/recordings

# End-of-call resolution (server/resolution.py). When a call ends having decided
# nothing, it submits the best ending it still stands behind instead of the
# out_of_scope refusal that matches no published case: the action it read back,
# then the first slot the platform offers the identified patient.
# COLD_BOOKING_TIMEOUT_SECS=6
# COLD_BOOKING_SPECIALTY=general_practice
# FALLBACK_TIMEOUT_SECS=12

# First-token deadline (server/llm_deadline.py). An attempt that produces no
# first chunk in time is abandoned and re-issued; when every attempt stalls the
# agent speaks one short line instead of leaving the line mute.
# LLM_FIRST_TOKEN_TIMEOUT_SECS=8
# LLM_ATTEMPTS=2
# LLM_HOLDING_LINE=One moment, please.
# LLM_FIRST_TOKEN_GUARD=0   # turn the deadline off (pipecat's retry_on_timeout only)

# Deploy guard (server/prosper_guard.py). Needs a way into the dashboard; the
# guard allows a restart when it cannot read the status at all.
# PROSPER_DASHBOARD_URL=https://hackspain.getprosperapp.com/leaderboard
# PROSPER_TEAM_ID=
# PROSPER_DASHBOARD_COOKIE=
# PROSPER_DASHBOARD_EMAIL=
# PROSPER_DASHBOARD_PASSWORD=
