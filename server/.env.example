# Copy this file to .env and fill in your API keys

# Clínica Arenal (HackSpain "El Turno" API)
CLINIC_API_BASE_URL=https://hackspain.getprosperapp.com/api
CLINIC_API_KEY=

# LLM provider: gemini (default) | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# Daily (WebRTC transport; optional)
DAILY_API_KEY=

# Twilio (only needed for auto hang-up via the Twilio REST API; the harness does not need it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Krisp VIVA noise-reduction (self-hosted). Set the API key; a missing
# voice-isolation .kef is downloaded when the bot process starts.
# Version id is on the Server SDK Versions tab at https://developers.krisp.ai
# KRISP_VIVA_API_KEY=
# KRISP_VIVA_SDK_VERSION_ID=
# KRISP_VIVA_FILTER_MODEL_PATH=/path/to/krisp-viva-vi-tel-v2.kef
# KRISP_VIVA_MODEL_CACHE=
# KRISP_NOISE_SUPPRESSION_LEVEL=100

# Tests only: pin the call's connect time (Europe/Madrid, ISO with offset)
# CALL_CLOCK_OVERRIDE=2026-09-18T10:00:00+02:00
