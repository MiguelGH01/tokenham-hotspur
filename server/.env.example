# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=

# Twilio (telephony transport; used by create_transport for Media Streams)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=



# Cartesia (STT/TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=


# OpenAI (STT/LLM/TTS/Realtime)
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: used in the flow prompt as {{ restaurant_name }}
RESTAURANT_NAME=Pipecat Pizza and Sushi

# Runtime menu — advertised as JSON-schema enums on the order tools
PIZZA_AVAILABLE=true
SUSHI_AVAILABLE=true
# Comma-separated items to remove from the tool enum this session
PIZZA_SOLD_OUT=
SUSHI_SOLD_OUT=

