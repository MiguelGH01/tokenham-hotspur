# Copy from server/.env or fill locally. Prefer VOICE_AGENT=elevenagent in server/.env
# and let Python spawn this process — standalone npm start still works without OBS_*.

ELEVENLABS_API_KEY=
AGENT_ID=
# Or use the same name as the Python backend:
# ELEVEN_AGENT_ID=

CLINIC_API_KEY=
CLINIC_API_BASE_URL=https://hackspain.getprosperapp.com/api

PORT=3000

# Optional: when run under the Python supervisor these are set automatically.
# OBS_INGEST_URL=http://127.0.0.1:7860/internal/obs/events
# OBS_INGEST_TOKEN=
